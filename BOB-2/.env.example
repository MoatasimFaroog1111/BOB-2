# GuardianAI Accountant & Auditor Enterprise — Environment
# Copy to .env. Never commit the populated .env file.

# Application
APP_NAME="GuardianAI Accountant & Auditor Enterprise"
APP_ENV=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=
TRUSTED_HOSTS=
# REQUIRED in production: exact reverse-proxy IPs/CIDRs only.
TRUSTED_PROXY_IPS=

# Tenant-neutral initial organization
GUARDIAN_DEFAULT_ORG_NAME="Default Organization"
GUARDIAN_DEFAULT_ORG_LEGAL_NAME="Default Organization"

# Database
# Local development may use sqlite:///./guardianai.db.
# Production must use PostgreSQL with a URL-encoded strong password.
POSTGRES_USER=guardian
POSTGRES_PASSWORD=
POSTGRES_DB=guardianai
DATABASE_URL=

# Shared rate limiting and session protection
REDIS_PASSWORD=
REDIS_URL=

# Security
# REQUIRED in production. Generate with: openssl rand -hex 64
SECRET_KEY=
REQUIRE_HTTPS=false
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=3

# Password recovery and invite-only account registration.
ACCOUNT_ACCESS_FRONTEND_URL=
RESEND_API_KEY=
ACCOUNT_EMAIL_FROM=

# Secret storage.
SECRET_STORE_PROVIDER=disabled
AZURE_KEY_VAULT_URL=
AZURE_MANAGED_IDENTITY_CLIENT_ID=
SECRET_STORE_ENCRYPTION_KEY=

# Telegram runtime — disabled by default.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_PRODUCTION_READY=false
TELEGRAM_ALLOW_GROUP_CHATS=false
TELEGRAM_APPROVAL_TTL_SECONDS=600
TELEGRAM_INGESTION_WORKERS=2
TELEGRAM_INGESTION_QUEUE_SIZE=20
TELEGRAM_MAX_PENDING_PER_ACTOR=1
TELEGRAM_MAX_PENDING_PER_ORGANIZATION=5
TELEGRAM_UPLOAD_RATE_LIMIT=5
TELEGRAM_UPLOAD_RATE_WINDOW_SECONDS=60
TELEGRAM_INGESTION_JOB_TTL_SECONDS=300
TELEGRAM_DOWNLOAD_TIMEOUT_SECONDS=30
TELEGRAM_DOWNLOAD_CHUNK_SIZE_BYTES=65536
TELEGRAM_MESSAGE_MAX_AGE_SECONDS=120
TELEGRAM_API_RESPONSE_MAX_BYTES=1048576

# ERP outbound SSRF policy — fail closed.
# Add the exact host(s) for the selected Odoo/SAP/Oracle/Business Central/QuickBooks/Xero endpoint.
# Examples for SaaS providers: api.businesscentral.dynamics.com,quickbooks.api.intuit.com,api.xero.com
ERP_OUTBOUND_REQUIRE_ALLOWLIST=true
ERP_OUTBOUND_ALLOWED_HOSTS=
ERP_OUTBOUND_ALLOWED_CIDRS=
ERP_OUTBOUND_ALLOWED_PORTS=443
ERP_OUTBOUND_ALLOW_HTTP=false
ERP_OUTBOUND_CONNECT_TIMEOUT_SECONDS=10
ERP_OUTBOUND_READ_TIMEOUT_SECONDS=30
ERP_OUTBOUND_MAX_RESPONSE_BYTES=52428800

# File uploads
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=200
MAX_IMAGE_PIXELS=40000000
MAX_ARCHIVE_FILES=500
MAX_ARCHIVE_UNCOMPRESSED_MB=100
OCR_TIMEOUT_SECONDS=60
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.txt,.csv,.tsv,.xlsx,.xls,.ofx,.qfx,.qif,.mt940,.sta
CLAMAV_HOST=
CLAMAV_PORT=3310
REQUIRE_MALWARE_SCAN=false
STORAGE_DIR=/data/storage
PERSISTENT_STORAGE_MOUNT_PATH=

# Development-only owner bootstrap.
GUARDIAN_SEED_EMAIL=
GUARDIAN_SEED_PASSWORD=

# Public frontend build/runtime configuration.
NEXT_PUBLIC_API_BASE_URL=

# Loopback-first LLM path.
LOCAL_LLM_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b
LOCAL_LLM_TIMEOUT_SECONDS=120
LOCAL_LLM_MAX_RESPONSE_BYTES=1048576

# Optional legacy OpenAI fallback path.
OPENAI_FALLBACK_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_ALLOWED_HOSTS=api.openai.com
OPENAI_FALLBACK_TIMEOUT_SECONDS=45
OPENAI_FALLBACK_MAX_RESPONSE_BYTES=1048576
OPENAI_MAX_OUTPUT_TOKENS=2048

# External LLM disclosure boundary — disabled globally by default.
# The provider/model selected in Settings is tenant-scoped; the credential is stored in the secret store.
EXTERNAL_LLM_ENABLED=false
EXTERNAL_LLM_REQUIRED_DPA_VERSION=2026-07-v1
EXTERNAL_LLM_ALLOWED_PROVIDERS=openai,anthropic,google,xai
EXTERNAL_LLM_ALLOWED_MODELS=openai:gpt-5.6-sol,openai:gpt-5.6-terra,openai:gpt-5.6-luna,openai:gpt-5.4,anthropic:claude-sonnet-5,anthropic:claude-opus-5,anthropic:claude-sonnet-4-6,google:gemini-3.6-flash,google:gemini-3.1-pro-preview,google:gemini-3.1-flash-lite,xai:grok-4.5,xai:grok-4.3
EXTERNAL_LLM_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,api.x.ai
EXTERNAL_LLM_MAX_REQUEST_BYTES=262144
EXTERNAL_LLM_MAX_RESPONSE_BYTES=1048576
EXTERNAL_LLM_MAX_REDACTED_TEXT_CHARS=4000

# Compatibility defaults used only when no tenant policy exists. A tenant policy is required before disclosure.
ACCOUNTING_LLM_PROVIDER=openai
ACCOUNTING_LLM_MODEL=gpt-5.6-sol
# Kept for backward-compatible production validation; the multi-provider gateway derives its actual endpoint from the selected provider.
ACCOUNTING_LLM_API_URL=https://api.anthropic.com/v1/messages
ACCOUNTING_LLM_TIMEOUT_SECONDS=45
ACCOUNTING_LLM_API_KEY=
ANTHROPIC_API_KEY=
